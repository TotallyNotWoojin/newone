{
  "expo": {
    "name": "Newone",
    "slug": "newone",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "icon": "./assets/images/newone-app-icon.png",
    "scheme": "newone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/newone-app-icon.png",
      "bundleIdentifier": "com.totallynotwoojin.newone",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Newone uses the camera only when you choose to take a photo or video to share in a conversation.",
        "NSMicrophoneUsageDescription": "Newone uses the microphone only when you record a voice message or a video to share."
      }
    },
    "android": {
      "package": "com.totallynotwoojin.newone",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/newone-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102E27",
          "image": "./assets/images/newone-splash.png",
          "imageWidth": 104
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Newone accesses only the photos and videos you choose to share in a conversation.",
          "cameraPermission": "Newone uses the camera only when you choose to take a photo or video to share in a conversation.",
          "microphonePermission": "Newone uses the microphone only when you record a voice message or a video to share."
        }
      ],
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2300fd06-3789-4d86-a2bb-856d57dca912"
      }
    },
    "owner": "totallynotwoojin"
  }
}
