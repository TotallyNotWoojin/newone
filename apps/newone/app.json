{
  "expo": {
    "name": "Newone",
    "slug": "newone-workplace",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "icon": "./assets/images/newone-app-icon.png",
    "scheme": "newone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/newone-app-icon.png",
      "bundleIdentifier": "com.newone.workplace",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Newone uses the camera only when you choose to attach an operational photo."
      }
    },
    "android": {
      "package": "com.newone.workplace",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/newone-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102E27",
          "image": "./assets/images/newone-splash.png",
          "imageWidth": 104
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Newone accesses only the photos you choose to attach to a workplace conversation.",
          "cameraPermission": "Newone uses the camera only when you choose to attach an operational photo.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
