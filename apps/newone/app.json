{
  "expo": {
    "name": "Gist",
    "slug": "newone",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "backgroundColor": "#F3F5F1",
    "icon": "./assets/images/gist-app-icon.png",
    "scheme": "gist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gist-app-icon.png",
      "bundleIdentifier": "com.totallynotwoojin.gist",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Gist uses the camera only when you choose to take a photo or video to share in a conversation.",
        "NSMicrophoneUsageDescription": "Gist uses the microphone only when you record a voice message or a video to share."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.totallynotwoojin.gist",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gist-adaptive-foreground.png",
        "backgroundColor": "#102E27"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gist-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gistchat.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102E27",
          "image": "./assets/images/gist-splash.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#0B211C",
            "image": "./assets/images/gist-splash.png",
            "imageWidth": 104
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gist accesses only the photos and videos you choose to share in a conversation.",
          "cameraPermission": "Gist uses the camera only when you choose to take a photo or video to share in a conversation.",
          "microphonePermission": "Gist uses the microphone only when you record a voice message or a video to share."
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Gist uses the microphone only when you record a voice message or a video to share.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2300fd06-3789-4d86-a2bb-856d57dca912"
      }
    },
    "owner": "totallynotwoojin"
  }
}
