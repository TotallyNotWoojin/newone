# Public identifiers only. Never place a Supabase secret/service-role key,
# OpenRouter key, push credential, or database credential in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Production web auth uses the Newone BFF and HttpOnly cookies. The standalone
# Expo web client does not persist bearer tokens in localStorage.
# Web production should use a same-origin reverse proxy path. Native build
# profiles may instead use the direct HTTPS function gateway URL.
EXPO_PUBLIC_API_URL=/api
EXPO_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-public-turnstile-site-key
EXPO_PUBLIC_TURNSTILE_CHALLENGE_ORIGIN=https://app.example.com/
EXPO_PUBLIC_SUPPORT_CONTACT_LABEL=Your organization support desk
EXPO_PUBLIC_SUPPORT_CONTACT_URL=https://support.example.com/newone

# Push registration fails closed unless both are provided by the EAS build
# environment. Project ID must be that build's real EAS UUID; environment must
# be exactly development, preview, or production.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_PUSH_ENVIRONMENT=

# Tenant-controlled encrypted recent-workspace caching. Set explicitly after
# the employer approves its device, retention, and shared-device policy.
EXPO_PUBLIC_OFFLINE_CACHE_ENABLED=false
