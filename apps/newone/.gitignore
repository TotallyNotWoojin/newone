# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies. No trailing slash: a symlink named node_modules is not a
# directory, and one committed by mistake replaced the real tree for everyone.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
credentials.json
