  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-coverage.mjs",
    "test:unit": "jest --runInBand --coverage=false",
    "test:coverage": "node tests/run-coverage.mjs",
    "test:coverage:report": "node tests/verify-coverage-report.mjs",
    "expo:deps:check": "expo install --check",
    "build:web": "expo export --platform web",
    "build:ios:verify": "expo export --platform ios --output-dir .expo/verify-ios --clear",
    "build:android:verify": "expo export --platform android --output-dir .expo/verify-android --clear",
    "verify:native": "npm run build:ios:verify && npm run build:android:verify",
    "check": "npm run expo:deps:check && npm run lint && npm run typecheck && npm run build:web && npm run verify:native"
  },
  "overrides": {
    "uuid": "11.1.1",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "test-exclude": {
      "minimatch": "3.1.5"
    }
  },
  "private": true
