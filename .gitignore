# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/playwright-report/
/test-results/
/release-artifacts/

# local source agreement is not part of the hosted application source
/Newone_Woojin_Contractor_Agreement (Claude) v7.docx

# Apple credentials must never enter the repository
*.p8

# Service-account credentials must never enter the repository
*firebase-adminsdk*.json
.metadata_never_index
*.nosync
*.nosync/

# Google Play service-account keys never belong in the repository
*service-account*.json
platinum-sorter-*.json
*.iam.gserviceaccount*.json

# iOS crash reports copied off a device while testing.
*.ips

# The Firebase client config carries a live Android API key. It is compiled
# into every APK and so is not a secret in the strict sense, but it was
# published here once and had to be rotated (Sep 2026). The canonical copy
# lives in ~/.config/newone/ and tools/release/sync-firebase-config.sh puts it
# in place for a build; verify-repository-security.mjs fails if it is ever
# tracked again.
google-services.json
GoogleService-Info.plist
