# Server-only AI credential. ChatGPT Pro does not include this.
OPENROUTER_API_KEY=

# Privacy-first defaults. Keep a versioned model and exact provider-region slug.
OPENROUTER_TRANSLATION_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_SUMMARY_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_PROVIDER=google-vertex/us-south1

# Must remain false until the Company and legal/privacy release gates are complete.
NEWONE_AI_DATA_EGRESS_APPROVED=false
NEWONE_APP_URL=http://localhost:3000

# Required in production. Comma-separated, exact lowercase or mixed-case emails.
NEWONE_ALLOWED_EMAILS=
NEWONE_MANAGER_EMAILS=
NEWONE_ADMIN_EMAILS=

# New approved users receive only these threads on first sign-in.
# Existing users are never silently re-enrolled.
NEWONE_DEFAULT_THREAD_IDS=
