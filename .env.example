# Newone server-only environment. Never copy these values into EXPO_PUBLIC_*.
# Supabase injects the first three automatically into deployed Edge Functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Exact web origins only, comma-separated. Do not use `*`.
NEWONE_ALLOWED_WEB_ORIGINS=https://app.newone.example
NEWONE_PUBLIC_APP_URL=https://app.newone.example
NEWONE_SUPABASE_FUNCTIONS_ORIGIN=https://your-project.supabase.co/functions/v1
NEWONE_ALLOW_HTTP_LOCAL=false
NEWONE_MAX_JSON_BYTES=65536
NEWONE_ACCESS_COOKIE_NAME=__Host-newone_access
NEWONE_REFRESH_COOKIE_NAME=__Host-newone_refresh
NEWONE_CSRF_COOKIE_NAME=__Host-newone_csrf

# Generate independent random values of at least 32 bytes per environment.
NEWONE_NETWORK_HASH_KEY=
# Independent HMAC key for low-entropy help-desk verification references.
# Never reuse the network key and never store the raw reference or identity documents.
NEWONE_RECOVERY_EVIDENCE_HASH_KEY=
# Independent shared secret installed in both Vercel and Supabase. The web BFF
# uses it to attest Vercel's non-spoofable ingress IP before Supabase adds its
# own proxy hop. Do not reuse NEWONE_NETWORK_HASH_KEY.
NEWONE_WEB_GATEWAY_SHARED_SECRET=
NEWONE_WORKER_TOKEN=
NEWONE_CURSOR_SIGNING_KEY=
# 32-byte base64url AES key for protected push tokens. Rotate through a
# versioned migration/re-encryption process; changing it invalidates old data.
NEWONE_PUSH_TOKEN_KEY_V1=

# Service-only initial-owner bootstrap. Leave unset/omit after the first
# confirmed owner has been provisioned; the endpoint then returns 404.
NEWONE_BOOTSTRAP_TOKEN=

# Production Auth challenges must agree with the hosted Supabase CAPTCHA
# setting and secret. Local development can set false.
NEWONE_AUTH_CAPTCHA_REQUIRED=true
# Remains false until a reviewed Supabase SMS provider, templates, limits, and
# cost alerts are configured. The API reports phone channel configured=false.
NEWONE_AUTH_PHONE_OTP_ENABLED=false

# Deploy generic outbox workers with the narrow topic set assigned to that
# worker instance. Do not let a public/browser request choose worker topics.
NEWONE_OUTBOX_TOPICS=moderation,realtime_control,storage_purge,session_revoke,dynamic_group_sync

# Add `push` to NEWONE_OUTBOX_TOPICS only after this token and the separate
# receipt-worker schedule are configured. Keep the access token server-only.
NEWONE_EXPO_ACCESS_TOKEN=
# Exact EAS project/environment accepted by this worker. The client registers
# Expo tokens only; raw APNs/FCM tokens fail validation.
NEWONE_EXPO_PROJECT_ID=00000000-0000-4000-8000-000000000000
NEWONE_PUSH_ENVIRONMENT=production

# Credential-free HTTPS scan gateway plus its independent bearer secret.
# The scanner must echo the SHA-256 digest and fail closed.
NEWONE_ATTACHMENT_SCANNER_URL=https://scanner.example.com/v1/scan
NEWONE_ATTACHMENT_SCANNER_TOKEN=

# AI egress remains disabled until the organization records its processor,
# region, use-case, and bilingual quality approvals.
NEWONE_AI_DATA_EGRESS_APPROVED=false
# Queue classes this worker is permitted to claim. This allowlist does not
# enable AI: the global egress flag, a versioned fail-closed route policy, and
# each organization's approved AI policy must all independently allow a use
# case before any employee content can leave Newone.
NEWONE_AI_WORKLOADS=language_detection,translation,summary
OPENROUTER_API_KEY=
# Employee-data processing requires a dedicated OpenRouter workspace and a
# separate Management API key. The worker verifies the exact completion key,
# rejects active Google Vertex BYOK credentials, rejects content-mutating
# guardrails, and checks the pinned uncached ZDR endpoint before every egress.
# The ordinary completion key alone is accepted only by synthetic eval tools.
OPENROUTER_MANAGEMENT_API_KEY=
NEWONE_OPENROUTER_API_KEY_HASH=
NEWONE_OPENROUTER_WORKSPACE_ID=
NEWONE_OPENROUTER_POLICY_JSON=
NEWONE_OPENROUTER_APP_NAME=Newone
